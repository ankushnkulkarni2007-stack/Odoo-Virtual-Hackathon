# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
# Either set MONGO_URI directly (recommended for MongoDB Atlas),
# or leave it blank and the individual DB_* values below are used instead.
MONGO_URI=
DB_HOST=localhost
DB_PORT=27017
DB_NAME=dayflow
DB_USER=
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
